# Admin login now delegates to saluna-backend's POST /auth/login (checked
# against the `users` table there) — ADMIN_EMAIL/ADMIN_PASSWORD are no longer
# read by this app, kept only for reference.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Must match saluna-backend's JWT_SECRET exactly — this app verifies the JWT
# the backend issues (it no longer signs its own token).
ADMIN_SESSION_SECRET=generate-a-long-random-hex-string
BACKEND_URL=http://localhost:4000
